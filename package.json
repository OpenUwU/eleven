{
	"name": "eleven",
	"version": "3.0.8",
	"description": "A Discord bot for music.",
	"type": "module",
	"license": "OUSL-1.0",
	"author": "OpenUWU",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx src/index.ts",
		"typecheck": "tsc --noEmit",
		"format": "biome format ./src --write",
		"lint": "biome lint ./src",
		"prepare": "husky",
		"migrate": "node scrpt/migrate.js"
	},
	"lint-staged": {
		"**/*.{ts,js}": [
			"node scrpt/header.js --stage",
			"biome format --write",
			"biome lint --write"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"engines": {
		"node": ">=20.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@commitlint/cli": "^21.1.0",
		"@commitlint/config-conventional": "^21.1.0",
		"@types/node": "^26.0.1",
		"@types/pg": "^8.20.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@types/bun": "^1.3.14",
		"discord-api-types": "^0.38.49",
		"discord-hybrid-sharding": "^3.0.1",
		"discord.js": "^14.26.4",
		"ioredis": "^5.11.1",
		"pg": "^8.22.0",
		"shoukaku": "^4.3.0",
		"zod": "^4.4.3"
	}
}
